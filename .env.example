# ============================================================================
# VIDYA AI — Environment Variables Template (SIH26101)
# ============================================================================
# NEVER commit real production keys to version control.
# Copy this file to .env for local development.
# ============================================================================

# --- AI Service Configuration (Optional BYOK / Backend Proxy) ---
# For client-side BYOK or direct proxy authentication:
VITE_GEMINI_API_KEY=your_gemini_api_key_here
# Optional backend API proxy URL (recommended for production to prevent client key exposure):
VITE_AI_PROXY_ENDPOINT=

# --- iGOT Karmayogi Integration (SIH26101 Mandatory) ---
# Supported Modes: MOCK | SANDBOX | LIVE | NOT_CONFIGURED
VITE_IGOT_INTEGRATION_MODE=MOCK
VITE_IGOT_API_ENDPOINT=
VITE_IGOT_CLIENT_ID=

# --- Firebase Client Configuration (From Firebase Console > Project Settings) ---
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
